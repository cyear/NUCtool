{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nuctool",
  "version": "1.0.1",
  "identifier": "com.cyear.nuctool",
  "build": {
    "frontendDist": "../src",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NUCtool",
        "width": 900,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "dll/NUCtool.dll": "NUCtool.dll"
    }
  }
}
